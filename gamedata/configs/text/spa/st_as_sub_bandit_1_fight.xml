	</string>
	
	<string id="as_sub_characters_voice_human_bandit_1_fight_searching_enemy_search_12">
		<text>¡No tengas miedo! ¡No te vamos a rajar!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_1_fight_searching_enemy_search_13">
