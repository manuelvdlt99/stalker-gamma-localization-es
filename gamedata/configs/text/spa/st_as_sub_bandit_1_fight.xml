	</string>
	
	<string id="as_sub_characters_voice_human_bandit_1_fight_post_combat_wait_relax_3">
		<text>¡Dejad de mirar, la acción ya se ha acabado!</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_1_fight_post_combat_wait_wait_1">
		<text>¡Eh, eh! ¡Es pronto para esconder el arma, chicos!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_1_fight_post_combat_wait_wait_2">
		<text>Bueno, vamos a esperar a más perdedores.</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_1_fight_post_combat_wait_wait_3">
		<text>¡Escondeos, escondeos, chicos!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_1_fight_post_combat_wait_wait_4">
