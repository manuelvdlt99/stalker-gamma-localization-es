  <string id="ui_mcm_dart_scale">
    <text>Escala</text>
  </string>

  <string id="ui_mcm_dart_scale_desc">
    <text>Ajusta el tamaño de este elemento. Los valores superiores a 1 harán que este elemento sea más grande. Los valores inferiores a 1 lo harán más pequeño.</text>
  </string>

  <string id="ui_mcm_dart_scale_note">
    <text>NOTA: El tamaño del texto es fijo y no puede ajustarse.</text>
  </string>

  <string id="ui_mcm_dart_offsetX">
    <text>Desplazamiento X</text>
  </string>

  <string id="ui_mcm_dart_offsetX_desc">
    <text>Ajusta la posición horizontal de este elemento. Los valores positivos lo mueven a la derecha. Los valores negativos lo mueven a la izquierda.</text>
  </string>

  <string id="ui_mcm_dart_offsetY">
    <text>Desplazamiento Y</text>
  </string>

  <string id="ui_mcm_dart_offsetY_desc">
    <text>Ajusta la posición vertical de este elemento. Los valores positivos lo mueven hacia abajo. Los valores negativos lo mueven hacia arriba.</text>
  </string>

  <string id="ui_mcm_dart_alignX">
    <text>Alineación horizontal</text>
  </string>

  <string id="ui_mcm_dart_alignX_desc">
    <text>Alinea este elemento horizontalmente con la zona especificada de la pantalla.</text>
  </string>

  <string id="ui_mcm_dart_alignY">
    <text>Alineación vertical</text>
  </string>

  <string id="ui_mcm_dart_alignY_desc">
    <text>Alinea este elemento verticalmente con la zona especificada de la pantalla.</text>
  </string>

  <string id="ui_mcm_dart_core_safezone">
    <text>Zona segura</text>
  </string>

  <string id="ui_mcm_dart_core_safezone_desc">
    <text>Acerca todos los elementos al centro de la pantalla en la cantidad especificada de píxeles.</text>
  </string>

  <string id="ui_mcm_dart_core_debugOptions_title">
    <text>Ajustes de depuración</text>
  </string>

  <string id="ui_mcm_dart_core_refreshKey">
    <text>Tecla de actualización manual del HUD</text>
  </string>

  <string id="ui_mcm_dart_core_refreshKey_desc">
    <text>Asigna una tecla para actualizar manualmente todos los elementos del HUD afectados por DART.</text>
  </string>

