<?xml version="1.0" encoding="Windows-1252"?>
<string_table>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_box_box_1">
		<text>Silent_Subtitle</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_joke_reaction_joke_1">
		<text>En plan, ¿de qué va?</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_joke_reaction_joke_2">
		<text>Ja, ja. Gracioso, no puedo más.</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_joke_reaction_joke_3">
		<text>Podrías haberme hablado de Stirlitz, comediante.</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_2_reactions_music_reaction_music_1">
		<text>Te llega al alma.</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_music_reaction_music_2">
		<text>No sabes tocar ni una sola nota.</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_2_reactions_music_reaction_music_3">
		<text>Y en nuestra cárcel de menores ni siquiera teníamos una guitarra.</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_music_reaction_music_4">
		<text>No, eso no es, no me llega.</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_music_reaction_music_5">
		<text>No, bueno, está claro que no lo he pillado, ¡es que no hay, como, ninguna continuación!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_music_reaction_music_6">
		<text>No, lo has hecho muy bien, ¡lo has tocado genial!</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_1">
		<text>¡Gha-ga-ja-ja!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_2">
		<text>¡Ja, ja, ja, ja, ja, ja, ja! ¡Me matas, en serio!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_3">
		<text>¡Ja, ja, ja, ja, ja, ja, ja! ¡Lo has hecho bien, demonio, de verdad!</text>
	</string>
	
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_4">
		<text>¡Jaaaaa, ja, ja, ja, ja, ja, jaaaa, jaa! ¡Eres bueno!</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_5">
		<text>¡Ja, ja, ja, ja, ja, ja, ja!</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_6">
		<text>¡Ja, ja, ja, ja, ja, ja, ja, joder!</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_2_reactions_story_laughter_7">
		<text>¡Gha-jajajajajaj-jaaa, joder!</text>
	</string>
</string_table>