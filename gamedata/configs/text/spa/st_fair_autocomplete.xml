<?xml version="1.0" encoding="windows-1252"?>
<string_table>

    <!-- MCM Menu Title -->
    <string id="ui_mcm_fair_autocomplete_title">
        <text>Autocompletar justo</text>
    </string>
    
    <string id="ui_mcm_menu_fair_autocomplete">
        <text>Autocompletar justo</text>
    </string>
    
    <!-- General Settings -->
    <string id="ui_mcm_fair_autocomplete_enable">
        <text>Activar mod</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_enable_desc">
        <text>Activa el seguimiento de bajas y la supervisión de tareas. Si se desactiva, el mod no hace nada.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_enable_autocomplete">
        <text>Activar autocompletar</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_enable_autocomplete_desc">
        <text>Las tareas se completarán automáticamente al eliminar a los objetivos. Si esta opción está desactivada, tendrás que visitar manualmente al encargado de la tarea, pero la detección de tareas robadas seguirá funcionando.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_pda_check">
        <text>Activar comprobación de PDA</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_pda_check_desc">
        <text>Solo autocompletar tareas si el jugador tiene una PDA.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_require_player_kill">
        <text>Exigir muertes de jugador o compañeros</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_require_player_kill_desc">
        <text>Las tareas solo se completan automáticamente si tú o tus compañeros habéis eliminado a los objetivos.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_companion_kills_count">
        <text>Las bajas de los compañeros cuentan</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_companion_kills_count_desc">
        <text>Las bajas que causen tus compañeros cuentan para completar la misión.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_count_assists">
        <text>Contar asistencias (impactos)</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_count_assists_desc">
        <text>Si tú o tus compañeros habéis alcanzado a un objetivo antes de que muriera, contarlo aunque haya sido otra persona quien le haya asestado el golpe mortal.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_max_kill_distance">
        <text>Distancia máxima de baja (0 = desactivado)</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_max_kill_distance_desc">
        <text>Distancia máxima del personaje cuando muere el objetivo. Fija el valor en 0 para desactivar la comprobación de distancia. Por defecto: 0 (desactivado)</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_require_same_level">
        <text>Exigir mismo nivel</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_require_same_level_desc">
        <text>El objetivo debe morir en el mismo nivel que el jugador para que la baja cuente.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_cancel_if_stolen">
        <text>Cancelar tareas robadas</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_cancel_if_stolen_desc">
        <text>Cancela las tareas sin penalización si otra persona ha eliminado a tu objetivo.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_check_interval">
        <text>Intervalo de comprobación (segundos)</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_check_interval_desc">
        <text>Con qué frecuencia comprobar si se ha completado una tarea. Un valor más bajo implica mayor capacidad de respuesta, pero un consumo ligeramente mayor de CPU.</text>
    </string>
    
    <!-- Task Types Headers -->
    <string id="ui_mcm_fair_autocomplete_task_types_header">
        <text>--- Tipos de tareas generales ---</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_special_tasks_header">
        <text>--- Tipos de tareas especiales ---</text>
    </string>
    
    <!-- General Task Types -->
    <string id="ui_mcm_fair_autocomplete_assault">
        <text>Tareas de asalto a campamento</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_assault_desc">
        <text>Eliminar mutantes o stalkers enemigos en una ubicación.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_bounty">
        <text>Tareas de recompensa</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_bounty_desc">
        <text>Eliminar a un stalker concreto.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_mutant_hunt">
        <text>Tareas de caza de mutantes</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_mutant_hunt_desc">
        <text>Cazar y eliminar mutantes (tareas de cazador).</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_hostage">
        <text>Tareas de rehén</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_hostage_desc">
        <text>Eliminar a los stalkers enemigos y salvar al rehén.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_spy_extract">
        <text>Tareas de extracción de espía</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_spy_extract_desc">
        <text>Eliminar a un escuadrón enemigo y extraer al espía.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_fate">
        <text>Tareas de destino</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_fate_desc">
        <text>«Señal perdida», «Investiga la ubicación de los exploradores», «Rastrea la señal de emergencia» y «Encuentra al soldado desaparecido del Deber».</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_scripted">
        <text>Tareas programadas</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_scripted_desc">
        <text>«Recupera el cargamento de Sidórovich» y Recupera el prototipo de detector».</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_retrieve">
        <text>Tareas de recuperación</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_retrieve_desc">
        <text>Buscar en un alijo determinado y devolver un objeto concreto del mismo.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_measurements">
        <text>Tareas de medición</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_measurements_desc">
        <text>Tomar mediciones en un campo anómalo.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_scanner">
        <text>Tareas de colocar escáner</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_scanner_desc">
        <text>«Campo de escaneo» y «Coloca el escáner cerca de la anomalía Simbionte».</text>
    </string>
    
    <!-- Special Task Types -->
    <string id="ui_mcm_fair_autocomplete_snitch">
        <text>Tarea «Toppers»</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_snitch_desc">
        <text>Matar a los stalkers mejor clasificados de las listas de facciones.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_spring_clean">
        <text>Tarea «Asegura la base»</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_spring_clean_desc">
        <text>Despejar mutantes de bases de facciones.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_defense">
        <text>Tarea «Defiende la estación de bombeo»</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_defense_desc">
        <text>Tareas de defensa de territorio de Petrenko.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_destroy_btrs">
        <text>Tarea «Por qué no podemos tener cosas bonitas»</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_destroy_btrs_desc">
        <text>Destruir vehículos militares.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_research_hunt">
        <text>Tarea «Caza de investigación de Semiónov»</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_research_hunt_desc">
        <text>Cazar mutantes específicos para la investigación de Semiónov.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_recover_tracker">
        <text>Tarea «Recupera el dispositivo de seguimiento»</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_recover_tracker_desc">
        <text>Matar mutantes con dispositivos de seguimiento pegados.</text>
    </string>
    
    <!-- Kill Requirement -->
    <string id="ui_mcm_fair_autocomplete_kill_requirement">
        <text>Requisito de bajas de asalto</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_kill_requirement_desc">
        <text>A cuántos enemigos hay que matar para que las misiones de asalto se completen automáticamente.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_kill_req_one">
        <text>Al menos un enemigo</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_kill_req_half">
        <text>Al menos la mitad</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_kill_req_all">
        <text>Todos los enemigos</text>
    </string>
    
    <!-- Rewards -->
    <string id="ui_mcm_fair_autocomplete_compensate_item_rewards">
        <text>Reemplazar objetos por dinero</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_compensate_item_rewards_desc">
        <text>Si se activa, los objetos obtenidos como recompensa por tareas autocompletadas se eliminarán de tu inventario y se sustituirán por su valor en dinero. Si se desactiva, recibirás los objetos como de costumbre.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_compensation_coefficient">
        <text>Coeficiente de compensación</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_compensation_coefficient_desc">
        <text>1.0 = El coste base del objeto. Los valores más bajos dan menos dinero.</text>
    </string>
    
    <!-- UI Options -->
    <string id="ui_mcm_fair_autocomplete_show_target_info">
        <text>Mostrar información ampliada del objetivo</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_show_target_info_desc">
        <text>Muestra información detallada sobre los objetivos de las tareas al aceptarlas.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_show_stolen_message">
        <text>Mostrar mensaje de tarea robada</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_show_stolen_message_desc">
        <text>Muestra un mensaje en la PDA cuando se cancele una tarea porque otra persona ha eliminado a tu objetivo.</text>
    </string>
    
    <!-- Advanced -->
    <string id="ui_mcm_fair_autocomplete_whitelist">
        <text>Lista blanca</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_whitelist_desc">
        <text>Identificadores de tareas separados por comas que siempre se completarán automáticamente (p. ej., «task_id_1,task_id_2»)</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_blacklist">
        <text>Lista negra</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_blacklist_desc">
        <text>Identificadores de tareas separados por comas que nunca se completarán automáticamente.</text>
    </string>
    
    <string id="ui_mcm_fair_autocomplete_debug">
        <text>Activar registros de depuración</text>
    </string>
    <string id="ui_mcm_fair_autocomplete_debug_desc">
        <text>Solo es útil para los modders. Muestra información detallada en la consola.</text>
    </string>
    
    <!-- In-game Messages -->
    <string id="st_fa_task_stolen_msg_1">
        <text>Alguien se ha encargado de eso por ti, nada personal.</text>
    </string>
    
    <string id="st_fa_task_stolen_msg_2">
        <text>La tarea la ha completado otra persona... bueno, cosas que pasan.</text>
    </string>
    
    <string id="st_fa_task_stolen_msg_3">
        <text>La Zona da, la Zona quita. ¡Vuelve en otro momento!</text>
    </string>
    
    <string id="st_fa_task_autocomplete_msg">
        <text>Tarea completada automáticamente.</text>
    </string>
    
    <string id="st_fa_target_info">
        <text>Información del objetivo</text>
    </string>

</string_table>
