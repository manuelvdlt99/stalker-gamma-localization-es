	</string>
	<string id="as_sub_characters_voice_human_bandit_3_help_wounded_heavy_help_1">
		<text>¡Me habéis dado!</text>
	</string>
	<string id="as_sub_characters_voice_human_bandit_3_help_wounded_heavy_help_2">
